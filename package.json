{
  "name": "linchuan-lan",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "server:dev": "tsx watch server/index.ts",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.server.json",
    "lint": "eslint src server test scripts vite.config.ts",
    "format:check": "prettier --check src server test scripts *.json *.ts *.js *.html",
    "test": "tsx --test test/*.test.ts",
    "test:browser": "tsx scripts/browser-check.ts",
    "test:network-browser": "tsx scripts/network-browser-check.ts",
    "build": "npm run typecheck && vite build && esbuild server/index.ts --bundle --platform=node --format=cjs --external:sharp --legal-comments=linked --outfile=build/server.cjs",
    "start": "node build/server.cjs",
    "package": "node scripts/package.mjs"
  },
  "engines": {
    "node": ">=24.14.1"
  },
  "dependencies": {
    "@peculiar/x509": "2.1.0",
    "@radix-ui/react-dropdown-menu": "^2.1.25",
    "busboy": "^1.6.0",
    "express": "^5.3.0",
    "flag-icons": "^7.5.0",
    "i18next": "^26.4.3",
    "lucide-react": "^1.55.0",
    "p-limit": "^7.3.3",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-i18next": "^17.0.16",
    "sharp": "^0.35.5",
    "werift": "0.25.0",
    "ws": "^8.22.0",
    "yet-another-react-lightbox": "^3.32.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.0",
    "@types/busboy": "^1.5.5",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.2",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.4"
  }
}
